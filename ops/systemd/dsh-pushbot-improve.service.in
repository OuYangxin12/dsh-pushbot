[Unit]
Description=DSH pushbot self-improvement run (one shot)
After=network-online.target

[Service]
Type=oneshot
Environment=PUSHBOT_ROOT=%h/pushbot
Environment=PATH=@NODE_DIR@:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/pushbot
ExecStart=/usr/bin/env bash %h/pushbot/ops/improve.sh
TimeoutStartSec=2400
StandardOutput=journal
StandardError=journal
